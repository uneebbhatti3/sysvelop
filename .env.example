# Names only. Never commit real values. Put real values in .env.local (or .env; both are git-ignored).
NEXT_PUBLIC_SITE_URL=

# Neon Postgres: use the *pooled* connection string. Stores enquiries and rate limits.
DATABASE_URL=

# Admin dashboard (/admin), Better Auth. Secret: 32+ random characters, e.g. the output of
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Then create the admin account with: npm run admin:create
BETTER_AUTH_SECRET=
# Public URL of the site, e.g. https://sysvelop.com (falls back to NEXT_PUBLIC_SITE_URL).
BETTER_AUTH_URL=
# Optional. IANA timezone for the dashboard chart's days, e.g. Europe/London. Defaults to UTC.
ADMIN_TIMEZONE=
